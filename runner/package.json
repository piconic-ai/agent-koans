{
  "name": "agent-koans",
  "version": "0.1.0",
  "description": "Conformance suite for AI agent implementations: deterministic koans run against your agent over HTTP, with the model played by a scripted mock",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-koans": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "koans"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piconic-ai/agent-koans.git",
    "directory": "runner"
  },
  "homepage": "https://github.com/piconic-ai/agent-koans#readme",
  "bugs": "https://github.com/piconic-ai/agent-koans/issues",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "testing",
    "conformance",
    "tool-calling",
    "openai"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc -p tsconfig.build.json && node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
